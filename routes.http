@token = <cole aqui o token retornado pelo login>
@userId = 65e5e90b4760390944a86f5a
@eventId = 65e5e95d4760390944a86f64

// ---------------------------------------------------------------------------
// Users
// ---------------------------------------------------------------------------

// Create new user (public)
POST http://localhost:3000/api/v2/user/new
Content-Type: application/json

{
    "firstName": "Henrique",
    "lastName": "Teste",
    "userName": "henriqueteste",
    "cpf": "444.777.666-40",
    "emailAddress": "henrique@test.com",
    "phoneNumber": "11951415851",
    "password": "hprhpr09",
    "confirmPassword": "hprhpr09",
    "gender": "Male"
}

###

// Get user by CPF (requires token)
GET http://localhost:3000/api/v2/user/document/44477766640
Authorization: Bearer {{token}}

###

// Get user by ID (requires token)
GET http://localhost:3000/api/v2/user/id/{{userId}}
Authorization: Bearer {{token}}

###

// Update user by ID (requires token; only editable fields are accepted)
PUT http://localhost:3000/api/v2/user/{{userId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "firstName": "Teste Atualização",
    "lastName": "Teste Atualização",
    "userName": "teste1atualizacao"
}

###

// Delete user by ID (requires token)
DELETE http://localhost:3000/api/v2/user/{{userId}}
Authorization: Bearer {{token}}

###

// ---------------------------------------------------------------------------
// Events
// ---------------------------------------------------------------------------

// Create new event (requires token)
POST http://localhost:3000/api/v2/event/new
Authorization: Bearer {{token}}
Content-Type: application/json

{
	"eventName": "Teste Evento",
	"eventDescription": "Teste Descrição Evento",
	"cnpj": "12.345.678/0001-21",
	"location": "Guarulhos",
	"eventType": "Social Event",
	"eventTicketPrice": 1000,
	"venueCapacity": 1000,
	"contactInformation": "Teste",
	"paymentMethodOption": "Credit"
}

###

// Get event by CNPJ (requires token; digits only in the path)
GET http://localhost:3000/api/v2/event/document/12345678000121
Authorization: Bearer {{token}}

###

// Get event by ID (requires token)
GET http://localhost:3000/api/v2/event/id/{{eventId}}
Authorization: Bearer {{token}}

###

// Update event by ID (requires token)
PUT http://localhost:3000/api/v2/event/{{eventId}}
Authorization: Bearer {{token}}
Content-Type: application/json

###

// Delete event by ID (requires token)
DELETE http://localhost:3000/api/v2/event/{{eventId}}
Authorization: Bearer {{token}}

###

// ---------------------------------------------------------------------------
// Authentication
// ---------------------------------------------------------------------------

// User login (public)
POST http://localhost:3000/api/v2/auth/login
Content-Type: application/json

{
	"emailAddress": "henrique@test.com",
	"password": "hprhpr09"
}

###

// Verify token (requires Authorization header)
POST http://localhost:3000/api/v2/auth/verifyToken
Authorization: Bearer {{token}}

###

// ---------------------------------------------------------------------------
// Cache
// ---------------------------------------------------------------------------

// Clear the shared cache (requires token; strategy is optional)
POST http://localhost:3000/api/v2/cache/clear
Authorization: Bearer {{token}}

###

POST http://localhost:3000/api/v2/cache/clear/nodeCache
Authorization: Bearer {{token}}
